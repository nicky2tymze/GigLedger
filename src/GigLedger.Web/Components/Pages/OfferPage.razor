@page "/offer"
@inject IOfferService Offers
@inject IShiftService Shifts
@inject TimeProvider Clock
@inject NavigationManager Nav
@inject HeldOffer Held

<PageTitle>Offer · GigLedger</PageTitle>

<h1>Offer</h1>
<p class="hint">Type in the offer as the platform shows it. Nothing is saved unless you accept or decline it.</p>

<div class="form">
    <label>Pay ($) <input id="pay" type="number" step="0.01" @bind="pay" /></label>
    <label>Stated miles <input id="stated-miles" type="number" step="0.1" @bind="statedMiles" /></label>
    <label>Drops <input id="drops" type="number" @bind="drops" /></label>
    <label>Items <input id="items" type="number" @bind="items" /></label>
    <label>Their estimate (min) <input id="est-minutes" type="number" @bind="estMinutes" /></label>
    <label>Return miles, if not the same as stated <input id="return-override" type="number" step="0.1" @bind="returnOverride" /></label>
    <button id="evaluate" @onclick="Evaluate">Evaluate</button>
</div>

@if (error is not null)
{
    <p class="error">@error</p>
}

@if (evaluation is not null)
{
    <section class="result">
        <p>Forecast net: <strong id="forecast">@Display.Rate(evaluation.Forecast.Value)</strong></p>
        <p id="verdict" class="@(evaluation.Verdict == Verdict.Clears ? "clears" : "short")">
            @(evaluation.Verdict == Verdict.Clears ? "Clears" : "Does not clear") @Display.Rate(evaluation.Threshold)
        </p>
        @if (evaluation.Forecast.RestsOnDefault)
        {
            <p class="hint">This forecast rests on:</p>
            <ul id="assumptions">
                @foreach (var a in evaluation.Forecast.Assumptions)
                {
                    <li>@a.Input: @a.Source</li>
                }
            </ul>
        }
        @if (open is not null)
        {
            <button id="accept" @onclick="Accept">Accept onto this shift</button>
            <button id="decline" @onclick="() => declining = true">Decline</button>
        }
        else
        {
            <button id="accept" @onclick="AcceptAndStartShift">Accept and start a shift</button>
        }
    </section>
}

@if (declining && open is not null && evaluation is not null)
{
    <section>
        <h2>Why decline?</h2>
        <div id="decline-reasons">
            @foreach (var reason in Enum.GetValues<DeclineReason>())
            {
                <label>
                    <input id="@($"reason-{reason}")" type="checkbox" checked="@chosen.Contains(reason)"
                           @onchange="e => Choose(reason, e.Value is true)" />
                    @DeclineRules.Label(reason)
                </label>
            }
        </div>
        <label>Note <input id="decline-note" @bind="declineNote" /></label>
        <button id="confirm-decline" @onclick="Decline">Confirm decline</button>
    </section>
}

@code {
    private decimal? pay, statedMiles, returnOverride;
    private int drops = 1, items;
    private int? estMinutes;

    private Core.Offer? offer;
    private OfferEvaluation? evaluation;
    private StoredShift? open;
    private string? error;

    private bool declining;
    private readonly HashSet<DeclineReason> chosen = [];
    private string? declineNote;

    protected override void OnInitialized() => open = Shifts.Open();

    private void Evaluate()
    {
        error = null;
        evaluation = null;
        if (pay is null || statedMiles is null || estMinutes is null)
        {
            error = "Enter the pay, the stated miles, and their time estimate.";
            return;
        }
        try
        {
            offer = new Core.Offer(
                new(pay.Value, Grade.Stated),
                new(statedMiles.Value, Grade.Stated),
                drops,
                items,
                new(estMinutes.Value, Grade.Stated),
                Clock.GetLocalNow(),
                returnOverride);
            evaluation = Offers.Evaluate(offer);
        }
        catch (Exception e) when (Refusal.IsRefusal(e))
        {
            error = Refusal.Reason(e);
        }
    }

    private void Choose(DeclineReason reason, bool on)
    {
        if (on) chosen.Add(reason);
        else chosen.Remove(reason);
    }

    private void Decline()
    {
        // Only the offer on screen, as last evaluated, can be declined.
        if (open is null || offer is null || evaluation is null) return;
        try
        {
            Offers.Decline(open.Id, offer, chosen.ToList(), declineNote, Clock.GetLocalNow());
            Nav.NavigateTo("/");
        }
        catch (Exception e) when (Refusal.IsRefusal(e))
        {
            error = Refusal.Reason(e);
        }
    }

    // FR-2b: hold the offer and go start a shift; starting it completes the accept.
    private void AcceptAndStartShift()
    {
        if (offer is null) return;
        Held.Hold(offer, Clock.GetLocalNow());
        Nav.NavigateTo("/");
    }

    private void Accept()
    {
        if (open is null || offer is null) return;
        try
        {
            Offers.Accept(open.Id, offer, Clock.GetLocalNow());
            Nav.NavigateTo("/");
        }
        catch (Exception e) when (Refusal.IsRefusal(e))
        {
            error = Refusal.Reason(e);
        }
    }
}
