@page "/"
@inject IShiftService Shifts
@inject ITripService Trips
@inject TimeProvider Clock
@inject IOfferService Offers
@inject HeldOffer Held

<PageTitle>Shift · GigLedger</PageTitle>

<h1>Shift</h1>

@if (error is not null)
{
    <p class="error">@error</p>
}

@if (pending is not null)
{
    <AcknowledgePanel Pending="pending" OnAcknowledge="Acknowledge" OnCancel="() => pending = null" />
}

@if (closedShift is not null)
{
    <p>Shift ended. <a id="summary" href="@($"/shifts/{closedShift}/summary")">See the summary</a></p>
}

@if (open is null)
{
    <section>
        <h2>Start a shift</h2>
        @if (Held.Offer is { } held)
        {
            <p id="held-offer">
                Accepted at @Display.Time(Held.AcceptPressedAt), waiting for this shift:
                @Display.Money(held.Pay.Value), @Display.Miles(held.StatedMiles.Value) stated, @held.Drops drops.
                Starting the shift records it.
            </p>
        }
        <div class="form">
            <label>Platform <input id="platform" @bind="platform" /></label>
            <label>Odometer <input id="start-odometer" type="number" step="0.1" @bind="startOdometer" /></label>
            <label>Start time <input id="start-time" type="datetime-local" @bind="startTime" /></label>
            <button id="start-shift" @onclick="Start">Start shift</button>
        </div>
    </section>
}
else
{
    <section>
        <p>
            @open.Platform shift open since <strong>@Display.Time(open.StartedAt)</strong>,
            odometer @Display.Miles(open.StartOdometer.Value) <span class="grade">@open.StartOdometer.Grade</span>
        </p>
        <p><a id="evaluate-offer" href="/offer">Evaluate an offer</a></p>

        <h2>Trips</h2>
        @if (trips.Count == 0)
        {
            <p class="hint">No trips yet.</p>
        }
        <table>
            @for (var i = 0; i < trips.Count; i++)
            {
                var index = i;
                var trip = trips[index];
                <tr class="trip">
                    <td>@Display.Time(trip.AcceptedAt)</td>
                    <td>@Display.Money(trip.Offer.Pay.Value) <span class="grade">@trip.Offer.Pay.Grade</span></td>
                    <td>@Display.Miles(trip.Offer.StatedMiles.Value) stated</td>
                    @if (trip.Cancel is { } cancelled)
                    {
                        @* FR-3a: what happened, what it paid, and on a shopped cancel what was driven against the offer. *@
                        <td colspan="5">
                            <span class="badge cancelled">cancelled</span>
                            by @CancelRules.Label(cancelled.Cancellation.By).ToLowerInvariant(), @CancelRules.Label(cancelled.Cancellation.Stage).ToLowerInvariant(),
                            at @Display.Time(cancelled.Cancellation.At) · paid <strong>@Display.Money(cancelled.Paid)</strong>
                            @if (cancelled.Cancellation.Reason is { } why)
                            {
                                <span> · @CancelRules.Label(why)@(cancelled.Cancellation.Note is { } note ? $": {note}" : "")</span>
                            }
                            @if (trip.Actuals is { } driven && reports[index].EstimateError is { } adjustment)
                            {
                                <span> · @driven.ElapsedMinutes.Value min, @Display.Miles(driven.RouteMiles.Value) out, @Display.Miles(driven.ReturnMiles.Value) back,
                                    mileage adjustment @Display.Miles(adjustment.MilesOver)</span>
                            }
                        </td>
                    }
                    else if (trip.Actuals is { } a)
                    {
                        <td>@a.ElapsedMinutes.Value min</td>
                        <td>@Display.Miles(a.RouteMiles.Value) out, @Display.Miles(a.ReturnMiles.Value) back</td>
                        <td>@Display.PerMile(Calculations.TruePerMile(trip.Offer.Pay.Value, a.Values).Value)</td>
                        <td>@Display.Share(Calculations.DeadheadShare(a.Values).Value) unpaid</td>
                        <td>net <span id="@($"net-{index}")">@Display.Rate(reports[index].Rates!.NetPerHour.Value)</span></td>
                    }
                    else
                    {
                        <td colspan="5" class="form">
                            <input id="@($"minutes-{index}")" type="number" placeholder="minutes" @bind="actuals[index].Minutes" />
                            <input id="@($"route-{index}")" type="number" step="0.1" placeholder="route mi" @bind="actuals[index].Route" />
                            <input id="@($"return-{index}")" type="number" step="0.1" placeholder="@(trip.Offer.Drops == 1 ? "return mi (= route)" : "return mi")" @bind="actuals[index].Return" />
                            <button id="@($"save-actuals-{index}")" @onclick="() => SaveActuals(index)">Save</button>
                            <button id="@($"cancel-{index}")" @onclick="() => StartCancel(index)">Cancel</button>
                        </td>
                    }
                </tr>
                @if (cancelling == index)
                {
                    <tr class="trip-cancel">
                        <td colspan="8">
                            <div class="form">
                                <label>Who cancelled
                                    <select id="cancel-by" @bind="cancel.By">
                                        @foreach (var by in Enum.GetValues<CancelledBy>())
                                        {
                                            <option value="@by">@CancelRules.Label(by)</option>
                                        }
                                    </select>
                                </label>
                                @if (cancel.By == nameof(CancelledBy.Driver))
                                {
                                    <label>Why
                                        <select id="cancel-reason" @bind="cancel.Reason">
                                            <option value="">choose</option>
                                            @foreach (var reason in Enum.GetValues<CancelReason>())
                                            {
                                                <option value="@reason">@CancelRules.Label(reason)</option>
                                            }
                                        </select>
                                    </label>
                                }
                                <label>When
                                    <select id="cancel-stage" @bind="cancel.Stage">
                                        @foreach (var stage in Enum.GetValues<CancelStage>())
                                        {
                                            <option value="@stage">@CancelRules.Label(stage)</option>
                                        }
                                    </select>
                                </label>
                                <label>Cancelled at <input id="cancel-at" type="datetime-local" @bind="cancel.At" /></label>
                                <label>Note <input id="cancel-note" @bind="cancel.Note" /></label>
                                @if (cancel.Stage != nameof(CancelStage.BeforePickup))
                                {
                                    <label>Minutes <input id="cancel-minutes" type="number" @bind="cancel.Minutes" /></label>
                                    <label>Route mi (offer: @Display.Miles(trip.Offer.StatedMiles.Value)) <input id="cancel-route" type="number" step="0.1" @bind="cancel.Route" /></label>
                                    <label>Return mi <input id="cancel-return" type="number" step="0.1" placeholder="@(trip.Offer.Drops == 1 ? "= route" : "")" @bind="cancel.Return" /></label>
                                    @if (trip.Offer.PromisedTip is null)
                                    {
                                        <label>Tip from the offer ($) <input id="cancel-tip" type="number" step="0.01" @bind="cancel.Tip" /></label>
                                    }
                                }
                                <button id="confirm-cancel" @onclick="ConfirmCancel">Confirm cancel</button>
                                <button id="cancel-back" @onclick="() => cancelling = null">Back</button>
                            </div>
                        </td>
                    </tr>
                }
                @if (trip.Actuals is not null)
                {
                    @* The trip's tip on a line of its own (FR-6, FR-6a): status, amounts, entry, then the final mark. *@
                    <tr class="trip-tip">
                        <td colspan="8">
                            <div class="tip-line">
                                @if (trip.Tips is { Tracked: true } state)
                                {
                                    @if (state.Pending)
                                    {
                                        <span class="badge pending">tip pending</span>
                                        <span>promised <strong>@Display.Money(trip.Offer.PromisedTip!.Value.Value)</strong></span>
                                        <span>posted <strong>@Display.Money(state.Posted)</strong></span>
                                    }
                                    else
                                    {
                                        <span class="badge all-in">all tips in</span>
                                        <span>promised <strong>@Display.Money(trip.Offer.PromisedTip!.Value.Value)</strong></span>
                                        <span>posted <strong>@Display.Money(state.Posted)</strong></span>
                                        <span>@Display.Money(state.Adjustment!.Value) against the promise</span>
                                    }
                                }
                                else if (trip.Tip is { } tip)
                                {
                                    <span>tips posted <strong>@Display.Money(tip.Value)</strong> <span class="hint">(inside the pay)</span></span>
                                }
                                else
                                {
                                    <span class="hint">No tip posted yet.</span>
                                }
                                <span class="tip-entry">
                                    <input id="@($"tip-{index}")" type="number" step="0.01" placeholder="tip posted" @bind="tips[index]" />
                                    <button id="@($"save-tip-{index}")" @onclick="() => SaveTip(index)">Save tip</button>
                                </span>
                                @if (trip.Cancel is null)
                                {
                                <span class="tip-entry">
                                    <input id="@($"promised-{index}")" type="number" step="0.01" placeholder="tip from the offer" @bind="promised[index].Amount" />
                                    @if (trip.Offer.PromisedTip is not null)
                                    {
                                        <input id="@($"promised-reason-{index}")" placeholder="reason for the change" @bind="promised[index].Reason" />
                                    }
                                    <button id="@($"set-promised-{index}")" @onclick="() => SetPromisedTip(index)">@(trip.Offer.PromisedTip is null ? "Add tip" : "Change tip")</button>
                                </span>
                                }
                                @if (trip.Cancel is null && trip.Tips is { Tracked: true, Pending: true })
                                {
                                    @if (Clock.GetUtcNow() >= trip.AllTipsInOpensAt)
                                    {
                                        <button id="@($"tips-in-{index}")" class="tips-in" @onclick="() => MarkAllTipsIn(index)">All tips in</button>
                                    }
                                    else
                                    {
                                        <span class="hint tips-in">All tips in from @Display.Time(trip.AllTipsInOpensAt)</span>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </table>

        <h2>End the shift</h2>
        <div class="form">
            <label>Odometer <input id="end-odometer" type="number" step="0.1" @bind="endOdometer" /></label>
            <label>End time <input id="end-time" type="datetime-local" @bind="endTime" /></label>
            <button id="end-shift" @onclick="End">End shift</button>
        </div>
    </section>
}

@code {
    private sealed class PromisedInput
    {
        public decimal? Amount { get; set; }
        public string? Reason { get; set; }
    }

    private sealed class CancelInput
    {
        public string By { get; set; } = nameof(CancelledBy.Customer);
        public string Stage { get; set; } = nameof(CancelStage.BeforePickup);
        public string? Reason { get; set; }
        public string? Note { get; set; }
        public DateTime At { get; set; }
        public int? Minutes { get; set; }
        public decimal? Route { get; set; }
        public decimal? Return { get; set; }
        public decimal? Tip { get; set; }
    }

    private sealed class ActualsInput
    {
        public int? Minutes { get; set; }
        public decimal? Route { get; set; }
        public decimal? Return { get; set; }
    }

    private StoredShift? open;
    private List<StoredTrip> trips = [];
    private List<ActualsInput> actuals = [];
    private List<TripReport> reports = [];
    private List<decimal?> tips = [];
    private List<PromisedInput> promised = [];
    private int? cancelling;
    private CancelInput cancel = new();
    private Guid? closedShift;
    private string? error;

    // SDD 6.10: a value past a limit waits here for the driver's confirm, then the same action runs again.
    private NeedsAcknowledgementException? pending;
    private Action<Acknowledgement?>? retry;

    private string platform = "Spark";
    private decimal? startOdometer, endOdometer;
    private DateTime startTime, endTime;

    protected override void OnInitialized()
    {
        startTime = endTime = Clock.GetLocalNow().DateTime;
        // FR-2b: a held offer's accept moment is the shift's default start, so the trip is never earlier.
        if (Held.Offer is not null)
            startTime = Held.AcceptPressedAt.DateTime;
        Load();
    }

    private void Load()
    {
        open = Shifts.Open();
        trips = open is null ? [] : Trips.OnShift(open.Id).ToList();
        actuals = trips.Select(_ => new ActualsInput()).ToList();
        reports = trips.Select(t => Trips.Report(t.Id)).ToList();
        tips = trips.Select(_ => (decimal?)null).ToList();
        promised = trips.Select(_ => new PromisedInput()).ToList();
    }

    private DateTimeOffset Local(DateTime time) => new(time, Clock.LocalTimeZone.GetUtcOffset(time));

    private void Attempt(Action action) => Attempt(_ => action());

    /// <summary>Runs a storing action; past a limit, keeps it to run again once acknowledged.</summary>
    private void Attempt(Action<Acknowledgement?> action, Acknowledgement? acknowledgement = null)
    {
        error = null;
        try
        {
            action(acknowledgement);
            pending = null;
            Load();
        }
        catch (NeedsAcknowledgementException e)
        {
            pending = e;
            retry = action;
        }
        catch (Exception e) when (Refusal.IsRefusal(e))
        {
            pending = null;
            error = Refusal.Reason(e);
        }
    }

    private void Acknowledge(Acknowledgement acknowledgement)
    {
        if (retry is { } action) Attempt(action, acknowledgement);
    }

    private void Start()
    {
        if (startOdometer is null) { error = "Enter the odometer reading."; return; }
        Attempt(() =>
        {
            var shift = Shifts.Start(platform, Local(startTime), new(startOdometer.Value, Grade.Measured));
            // FR-2b: starting the shift completes the held accept, at the moment accept was pressed.
            if (Held.Offer is { } held)
            {
                Offers.Accept(shift, held, Held.AcceptPressedAt, Held.Acknowledgement);
                Held.Clear();
            }
        });
    }

    private void SaveActuals(int index)
    {
        var input = actuals[index];
        var back = ReturnOrDefault(trips[index], input.Route, input.Return);
        if (input.Minutes is null || input.Route is null || back is null)
        {
            error = "Enter the minutes, the route miles, and the return miles.";
            return;
        }
        var (trip, entered) = (trips[index].Id, new GradedActuals(
            new(input.Minutes.Value, Grade.Entered),
            new(input.Route.Value, Grade.Entered),
            new(back.Value, Grade.Entered)));
        Attempt(ack => Trips.RecordActuals(trip, entered, ack));
    }

    /// <summary>FR-3: a one-drop trip's return defaults to its route when left blank.</summary>
    private static decimal? ReturnOrDefault(StoredTrip trip, decimal? route, decimal? back) =>
        back ?? (trip.Offer.Drops == 1 ? route : null);

    private void StartCancel(int index)
    {
        error = null;
        cancelling = index;
        cancel = new CancelInput { At = Clock.GetLocalNow().DateTime, Route = trips[index].Offer.StatedMiles.Value };
    }

    // FR-3a: the service decides what a cancel needs; the page only gathers it.
    private void ConfirmCancel()
    {
        if (cancelling is not { } index) return;
        var trip = trips[index];
        var by = Enum.Parse<CancelledBy>(cancel.By);
        CancelReason? reason = by == CancelledBy.Driver && !string.IsNullOrEmpty(cancel.Reason) ? Enum.Parse<CancelReason>(cancel.Reason) : null;
        var cancellation = new Cancellation(Local(cancel.At), by, Enum.Parse<CancelStage>(cancel.Stage), reason, cancel.Note);
        GradedActuals? driven = null;
        if (cancellation.Shopped)
        {
            var back = ReturnOrDefault(trip, cancel.Route, cancel.Return);
            if (cancel.Minutes is null || cancel.Route is null || back is null)
            {
                error = "Enter the minutes, the route miles, and the return miles.";
                return;
            }
            driven = new(new(cancel.Minutes.Value, Grade.Entered), new(cancel.Route.Value, Grade.Entered), new(back.Value, Grade.Entered));
        }
        var tip = cancel.Tip;
        Attempt(ack =>
        {
            Trips.Cancel(trip.Id, cancellation, driven, tip, ack);
            cancelling = null;
        });
    }

    // FR-6a: add the offer's tip after accept, or change it; the service decides when a reason is needed.
    private void SetPromisedTip(int index)
    {
        if (promised[index].Amount is not { } amount) { error = "Enter the tip from the offer."; return; }
        var (trip, reason) = (trips[index].Id, promised[index].Reason);
        Attempt(ack => Trips.SetPromisedTip(trip, amount, reason, ack));
    }

    private void MarkAllTipsIn(int index)
    {
        var (trip, at) = (trips[index].Id, Clock.GetLocalNow());
        Attempt(() => Trips.MarkAllTipsIn(trip, at));
    }

    private void SaveTip(int index)
    {
        if (tips[index] is not { } amount) { error = "Enter the tip as it posted."; return; }
        var (trip, at) = (trips[index].Id, Clock.GetLocalNow());
        Attempt(ack => Trips.RecordTip(trip, amount, at, ack));
    }

    private void End()
    {
        if (open is null) return;
        if (endOdometer is null) { error = "Enter the odometer reading."; return; }
        var (id, at, odometer) = (open.Id, Local(endTime), new Graded<decimal>(endOdometer.Value, Grade.Measured));
        Attempt(ack =>
        {
            Shifts.End(id, at, odometer, ack);
            closedShift = id;
        });
    }
}
